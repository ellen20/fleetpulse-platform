{
  "name": "fleetpulse-tests",
  "version": "1.0.0",
  "description": "FleetPulse E2E Testing Suite",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:assignment": "playwright test tests/assignment-workflow.spec.js",
    "report": "playwright show-report",
    "cy:run": "start-server-and-test start http://localhost:3000 cypress:open"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^24.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@cucumber/cucumber": "^13.2.0",
    "@cucumber/html-formatter": "^24.1.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "cypress": "^15.11.0",
    "start-server-and-test": "^2.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "wait-on": "^9.1.0"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": false,
    "stepDefinitions": "cypress/support/step_definitions/**/*.js"
  }
}
